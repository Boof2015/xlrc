{
  "name": "@boof2015/xlrc",
  "version": "0.1.1",
  "description": "Parser and toolkit for the XLRC lyric format",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boof2015/xlrc.git"
  },
  "keywords": [
    "lyrics",
    "lrc",
    "xlrc",
    "music"
  ],
  "author": "Boof2015",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "bugs": {
    "url": "https://github.com/Boof2015/xlrc/issues"
  },
  "homepage": "https://github.com/Boof2015/xlrc#readme"
}
